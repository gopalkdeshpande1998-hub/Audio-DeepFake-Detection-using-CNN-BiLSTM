# GPU image (NVIDIA Container Toolkit required): same app and API, CUDA builds of torch.
#   docker build -f Dockerfile.gpu -t adfd:gpu .
FROM nvidia/cuda:13.0.0-cudnn-runtime-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3.11 python3.11-venv python3-pip libsndfile1 \
    && rm -rf /var/lib/apt/lists/* && python3.11 -m venv /venv
ENV PATH=/venv/bin:$PATH
WORKDIR /app
COPY requirements-train.txt pyproject.toml ./
RUN pip install --no-cache-dir -r requirements-train.txt
COPY src ./src
COPY api ./api
COPY app.py ./
COPY .streamlit ./.streamlit
COPY configs ./configs
RUN pip install --no-cache-dir --no-deps -e .
ENV HF_HOME=/app/.cache/huggingface ADFD_DEVICE=cuda PYTHONUNBUFFERED=1
EXPOSE 8501 8000
CMD ["streamlit", "run", "app.py", "--server.port", "8501", "--server.address", "0.0.0.0", "--server.headless", "true"]
